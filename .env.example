# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-replace-with-a-secure-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (PostgreSQL for Docker / Production)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=portfolio_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# GitHub Sync Integration (Optional: avoids GitHub unauthenticated rate limits)
GITHUB_TOKEN=
GITHUB_USERNAME=yourusername

# Notifications
NOTIFICATION_EMAIL=admin@example.com
DEFAULT_FROM_EMAIL=portfolio@example.com

