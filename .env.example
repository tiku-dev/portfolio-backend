# ========================================================
# Portfolio Backend Environment Variables (Vercel & Local)
# ========================================================

# Django Core
DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=*

# Database (Neon Serverless PostgreSQL for Vercel)
DATABASE_URL=

# Email Notifications (Gmail SMTP)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
NOTIFICATION_EMAIL=

# GitHub Sync Integration (Optional)
GITHUB_TOKEN=
GITHUB_USERNAME=
GITHUB_AUTO_SYNC_PROJECTS=

# Redis / Celery (Optional in serverless)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
